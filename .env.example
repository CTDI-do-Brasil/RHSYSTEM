# ==========================================
# Configurações do Sistema CFT & MinIO
# ==========================================

# Porta onde o servidor web irá rodar
PORT=3000

# ==========================================
# Banco de Dados PostgreSQL
# ==========================================
# Host: Em produção no CapRover use 'srv-captain--db-postgres'
# Para desenvolvimento local use o IP/host externo ou 'localhost'
DB_HOST=srv-captain--db-postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=RH-SYSTEM
DB_SSL=false

# Ou use a URL direta de conexão se preferir:
# DATABASE_URL=postgresql://postgres:senha@srv-captain--db-postgres:5432/RH-SYSTEM

# ==========================================
# Armazenamento MinIO (Anexos & Documentos)
# ==========================================
# Endereço do servidor MinIO (ex: localhost, 192.168.1.100 ou s3.suaempresa.com)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=cft-anexos
