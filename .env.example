# ==========================================
# Configurações do Sistema CFT & MinIO
# ==========================================

# Porta onde o servidor web irá rodar
PORT=3000

# Endereço do servidor MinIO (ex: localhost, 192.168.1.100 ou s3.suaempresa.com)
MINIO_ENDPOINT=localhost

# Porta da API do MinIO (padrão do MinIO é 9000)
MINIO_PORT=9000

# Usar SSL/HTTPS (true para conexões seguras https, false para http normal)
MINIO_USE_SSL=false

# Credenciais de Acesso (Access Key / User e Secret Key / Password)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Nome do Bucket onde os anexos serão guardados
MINIO_BUCKET=cft-anexos
